{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.100",
  "supportsChannelFeatures": "tier1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Teams SDK MVP",
    "websiteUrl": "https://${{TAB_DOMAIN}}/",
    "privacyUrl": "https://${{TAB_DOMAIN}}/privacy",
    "termsOfUseUrl": "https://${{TAB_DOMAIN}}/termsOfUse"
  },
  "name": {
    "short": "업무 허브",
    "full": "Teams SDK 업무 허브 MVP"
  },
  "description": {
    "short": "Teams에서 에이전트 작업을 실행하고 추적합니다.",
    "full": "Teams SDK로 만든 에이전트 업무 허브입니다. Bot에서 에이전트 작업을 실행하고, 탭에서 프롬프트와 진행 상황 및 관찰된 도구를 확인할 수 있습니다."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",
  "staticTabs": [
    {
      "entityId": "home",
      "name": "업무 허브",
      "scopes": ["personal"],
      "websiteUrl": "https://${{TAB_DOMAIN}}/",
      "contentUrl": "https://${{TAB_DOMAIN}}/tabs/home/"
    }
  ],
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            { "title": "help", "description": "사용 가능한 명령을 보여줍니다." },
            { "title": "agent run", "description": "읽기 전용 Core 에이전트 작업을 시작합니다." },
            { "title": "agent write", "description": "승인이 필요한 작업공간 변경 작업을 시작합니다." },
            { "title": "agent choose", "description": "모델과 추론 수준을 선택해 읽기 작업을 시작합니다." },
            { "title": "agent status", "description": "Core 에이전트 작업 상태를 확인합니다." },
            { "title": "agent list", "description": "Core 에이전트 작업 목록을 확인합니다." },
            { "title": "agent cancel", "description": "Core 에이전트 작업 취소를 요청합니다." },
            { "title": "agent approve", "description": "쓰기 작업 승인을 처리합니다." },
            { "title": "agent retry", "description": "실패한 Core 에이전트 작업을 다시 시도합니다." },
            { "title": "agent input", "description": "입력이 필요한 Core 에이전트 작업에 값을 전달합니다." }
          ]
        }
      ]
    }
  ],
  "validDomains": ["${{TAB_DOMAIN}}", "token.botframework.com"],
  "webApplicationInfo": {
    "id": "${{CLIENT_ID}}",
    "resource": "${{APPLICATION_ID_URI}}"
  }
}
