{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.98",
  "supportsChannelFeatures": "tier1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Teams SDK MVP",
    "websiteUrl": "https://${{TAB_DOMAIN}}/",
    "privacyUrl": "https://${{TAB_DOMAIN}}/privacy",
    "termsOfUseUrl": "https://${{TAB_DOMAIN}}/termsOfUse"
  },
  "name": {
    "short": "업무 허브",
    "full": "Teams SDK 업무 허브 MVP"
  },
  "description": {
    "short": "Teams 안에서 업무를 확인하고 추가합니다.",
    "full": "Teams SDK로 만든 내부용 업무 허브 MVP입니다. 탭에서 업무 목록을 보고 Teams 메시지 엔드포인트와 연동하며, 모바일 Teams 위치 권한으로 현재 위치 날씨를 확인할 수 있습니다."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",
  "staticTabs": [
    {
      "entityId": "home",
      "name": "업무 허브",
      "scopes": ["personal"],
      "websiteUrl": "https://${{TAB_DOMAIN}}/",
      "contentUrl": "https://${{TAB_DOMAIN}}/tabs/home/"
    }
  ],
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            { "title": "help", "description": "사용 가능한 명령을 보여줍니다." },
            { "title": "날씨", "description": "현재 위치 날씨 위젯을 확인합니다." },
            { "title": "status", "description": "앱 상태를 확인합니다." },
            { "title": "list", "description": "진행 중인 업무 목록을 보여줍니다." }
          ]
        }
      ]
    }
  ],
  "validDomains": ["${{TAB_DOMAIN}}", "token.botframework.com"],
  "devicePermissions": ["geolocation"],
  "webApplicationInfo": {
    "id": "${{CLIENT_ID}}",
    "resource": "${{APPLICATION_ID_URI}}"
  }
}
