PORT=3978
NODE_ENV=development
ITEM_STORE_PATH=./data/items.json
# Teams response renderer: hybrid uses native Adaptive Cards with legacy text fallback.
TEAMS_GENUI_MODE=hybrid
# Persistent, one-time GenUI approval/action grants.
GENUI_ACTION_STORE_PATH=./data/genui-actions.json
# GenAI runtime. The CopilotKit agent uses the OpenAI-compatible Chat Completions API.
# OPENAI_API_KEY=<secret; never commit this value>
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional xAI Responses API provider. The key is read only by the server.
# XAI_API_KEY=<secret; never commit this value>
# XAI_MODEL=grok-4.6
# XAI_BASE_URL=https://api.x.ai/v1
# Release profile defaults to the Core runtime. Set both values only for an
# explicitly approved Grok production candidate; keep XAI_API_KEY in a secret
# manager and never commit it.
TEAMS_RELEASE_RUNTIME=core
# TEAMS_RELEASE_RUNTIME=optional
# TEAMS_OPTIONAL_RUNTIME=true
# Azure canary contract. Keep the file backend until the separately verified
# Cosmos backend is enabled; all Azure values are identity-based endpoints, not keys.
# TEAMS_STORAGE_BACKEND=azure-cosmos
# AZURE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# AZURE_COSMOS_DATABASE=teamsapp
# AZURE_COSMOS_CONTAINER=runtime-state
# AZURE_STORAGE_QUEUE_ENDPOINT=https://<account>.queue.core.windows.net/
# AZURE_STORAGE_FILE_ENDPOINT=https://<account>.file.core.windows.net/
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# Optional release only: select Grok for new Teams scopes. The current Core
# default remains deterministic when this value is omitted.
# TEAMS_RESPONSE_MODE_DEFAULT=grok
# Optional local/enterprise OpenAI-compatible provider. These values are read
# only by the server; the Teams client cannot supply or override them.
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=local-model
# LOCAL_MODEL_API_KEY=<optional server-side key; never commit this value>
# Local-only. Both flags are required for the loopback-only local bypass/MCP mode.
TEAMS_SKIP_AUTH=false
TEAMS_LOCAL_DEV=false
# Optional authenticated provider MCP. Keep disabled unless the explicit
# public HTTPS resource, Entra authorization-server issuer, provider site, and
# server-side provider credentials have all been configured and verified.
# TEAMS_MCP_AUTHENTICATED_ENABLED=false
# MCP_RESOURCE_ORIGIN=https://<observed-public-host>
# MCP_AUTHORIZATION_SERVER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# TEAMS_MCP_AUTH_CLIENT_ID=<separate Entra resource app ID>
# TEAMS_MCP_AUTH_APPLICATION_ID_URI=<separate MCP resource app URI>
# TEAMS_MCP_AUTH_ACCEPTED_AUDIENCES=<MCP resource client ID or URI>
# TEAMS_MCP_AUTH_REQUIRED_SCOPE=<registered delegated MCP scope>
# TEAMS_MCP_PROVIDER_TOOLS=true
# ATLASSIAN_SITE_URL=https://<site>.atlassian.net
# ATLASSIAN_ACCESS_TOKEN=<server-side secret; never commit this value>
# BITBUCKET_ACCESS_TOKEN=<server-side secret; never commit this value>
# Test-only deterministic agent. Do not set this in production; it disables the LLM path.
# COPILOTKIT_DETERMINISTIC_MODE=true
# Required for a real Teams registration/sideload flow. Keep secrets out of Git:
# CLIENT_ID=<Microsoft Entra app ID used by the tab/SSO manifest>
# BOT_CLIENT_ID=<Azure Bot app ID used by Teams SDK service authentication>
# CLIENT_SECRET=<secret for BOT_CLIENT_ID; never commit this value>
# TENANT_ID=
# APPLICATION_ID_URI=api://<TAB_DOMAIN>/botid-<BOT_CLIENT_ID>
# Must exactly match the observed Bot Entra Expose an API Application ID URI.
# Production-only explicit allowlists. The audience list may contain the
# registered client ID and the observed Application ID URI, separated by commas.
# TEAMS_USER_AUTH_ACCEPTED_AUDIENCES=<CLIENT_ID>,<APPLICATION_ID_URI>
# Workspace-write, approve, cancel, and commit bot commands are restricted to
# the exact Teams/Entra requester IDs listed here. Read-only commands remain available.
# TEAMS_OPERATOR_REQUESTER_ALLOWLIST=<TENANT_ID>/<AAD_OBJECT_ID_OR_OBSERVED_TEAMS_REQUESTER_ID>
# The default CLI provider is selected above by TEAMS_AGENT_CLI_PROVIDER (codex by default).
# A2A may register additional independent workers only when explicitly listed;
# this does not prove CLI login, Copilot entitlement, or tenant policy.
# TEAMS_AGENT_CLI_PROVIDER=codex
# TEAMS_A2A_AGENT_PROVIDERS=codex,copilot
# Production Codex A2A requires a separate owner-only Codex home per indexed
# worker. Do not point these at AGENT_CODEX_HOME or copy auth.json between them.
# TEAMS_A2A_AGENT_PROVIDERS=codex,codex
# AGENT_CODEX_HOME=/srv/teams-agent/codex-service
# AGENT_CODEX_HOME_1=/srv/teams-agent/codex-a2a-1
# AGENT_CODEX_HOME_2=/srv/teams-agent/codex-a2a-2
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# CODEX_BIN_SHA256=<operator-pinned SHA-256>
# Optional independently addressable remote A2A roster. Each entry contains
# only a token environment-variable name; credentials stay server-side.
# Do not combine this roster with the legacy single remote settings.
# TEAMS_A2A_REMOTE_AGENTS=[{"agentId":"remote-reviewer","providerId":"grok-hermes-prod","kind":"grok-hermes","endpoint":"https://agent.example.com/a2a","tokenEnv":"REMOTE_REVIEWER_TOKEN","executionIdentity":"remote-reviewer-prod","executionBoundaryId":"remote-reviewer-boundary-1","roles":["reviewer"],"capabilities":["review.report","source.read"]}]
# TEAMS_APP_ID=
# TEAMS_CATALOG_APP_ID=<Teams Admin Center org catalog ID used by /l/entity deep links>
# BOT_ID=<Teams/Bot registration ID used for messaging; it may differ from CLIENT_ID>
# TAB_DOMAIN=
