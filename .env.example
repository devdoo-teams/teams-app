PORT=3978
NODE_ENV=development
ITEM_STORE_PATH=./data/items.json
# Teams response renderer: hybrid uses native Adaptive Cards with legacy text fallback.
TEAMS_GENUI_MODE=hybrid
# Persistent, one-time GenUI approval/action grants.
GENUI_ACTION_STORE_PATH=./data/genui-actions.json
# GenAI runtime. The CopilotKit agent uses the OpenAI-compatible Chat Completions API.
# OPENAI_API_KEY=<secret; never commit this value>
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local-only. Both flags are required for the loopback-only local bypass/MCP mode.
TEAMS_SKIP_AUTH=false
TEAMS_LOCAL_DEV=false
# Test-only deterministic agent. Do not set this in production; it disables the LLM path.
# COPILOTKIT_DETERMINISTIC_MODE=true
# Required for a real Teams registration/sideload flow. Keep secrets out of Git:
# CLIENT_ID=<Microsoft Entra app ID used by the tab/SSO manifest>
# BOT_CLIENT_ID=<Azure Bot app ID used by Teams SDK service authentication>
# CLIENT_SECRET=<secret for BOT_CLIENT_ID; never commit this value>
# TENANT_ID=
# APPLICATION_ID_URI=api://<registered-application-id-uri>
# TEAMS_APP_ID=
# BOT_ID=<Teams/Bot registration ID used for messaging; it may differ from CLIENT_ID>
# TAB_DOMAIN=
