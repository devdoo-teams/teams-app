{
  "name": "teams-sdk-mvp",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:mcp && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:mcp": "node scripts/build-mcp-widget.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:types": "npm run typecheck",
    "check:deployment": "node scripts/validate-deployment-env.mjs",
    "test:deployment-env": "node scripts/deployment-env-test.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "package:app": "node scripts/package-app.mjs",
    "test:troubleshooting": "tsx scripts/remote-troubleshooting-test.ts",
    "test:atomic-stores": "tsx scripts/atomic-json-store-test.ts",
    "test:agent-job-hardening": "tsx scripts/agent-job-store-hardening-test.ts",
    "test:genui-action-hardening": "tsx scripts/genui-action-store-hardening-test.ts",
    "test:genui-redaction": "tsx scripts/genui-redaction-test.ts",
    "test:genui-actions": "tsx scripts/genui-action-store-test.ts",
    "test:item-store-hardening": "tsx scripts/item-store-hardening-test.ts",
    "test:process-lease-hardening": "tsx scripts/process-lease-hardening-test.ts",
    "test:agent-transitions": "tsx scripts/agent-service-transition-test.ts",
    "test:genui-contract": "tsx scripts/genui-contract-test.ts",
    "test:teams-tab-link": "tsx scripts/teams-tab-link-test.ts",
    "test:channels-shadow": "tsx scripts/channels-shadow-test.ts",
    "test:deterministic-engine": "tsx scripts/deterministic-response-engine-test.ts",
    "test:openai-engine": "tsx scripts/openai-response-engine-test.ts",
    "test:local-engine": "tsx scripts/local-response-engine-test.ts",
    "test:response-mode-store": "tsx scripts/response-mode-store-test.ts",
    "test:response-mode-api": "tsx scripts/response-mode-api-test.ts",
    "test:client-auth": "tsx scripts/client-auth-test.ts",
    "test:client-genui-adapter": "tsx scripts/client-genui-adapter-test.ts",
    "test:client-response-mode": "tsx scripts/client-response-mode-test.ts",
    "test:local-auth": "tsx scripts/local-auth-test.ts",
    "test:weather-service": "tsx scripts/weather-service-test.ts",
    "test:mcp-response-mode": "tsx scripts/mcp-response-mode-test.ts",
    "test:mcp-direct-factory": "tsx scripts/mcp-direct-factory-test.ts",
    "check": "npm run build:client && npm run validate:manifest",
    "test:runtime": "node scripts/runtime-test.mjs",
    "test": "npm run check && npm run test:deployment-env && npm run build && npm run test:troubleshooting && npm run test:atomic-stores && npm run test:agent-job-hardening && npm run test:genui-action-hardening && npm run test:genui-redaction && npm run test:genui-actions && npm run test:item-store-hardening && npm run test:process-lease-hardening && npm run test:agent-transitions && npm run test:genui-contract && npm run test:teams-tab-link && npm run test:channels-shadow && npm run test:response-mode-store && npm run test:deterministic-engine && npm run test:openai-engine && npm run test:local-engine && npm run test:response-mode-api && npm run test:client-auth && npm run test:client-genui-adapter && npm run test:client-response-mode && npm run test:local-auth && npm run test:weather-service && npm run test:mcp-response-mode && npm run test:mcp-direct-factory && npm run test:runtime"
  },
  "dependencies": {
    "@copilotkit/channels-teams": "0.7.3",
    "@copilotkit/channels-ui": "0.7.3",
    "@copilotkit/react-core": "^1.66.2",
    "@copilotkit/runtime": "^1.66.2",
    "@microsoft/teams-js": "^2.54.0",
    "@microsoft/teams.apps": "^2.0.15",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api-logs": "0.214.0",
    "esbuild": "^0.28.1",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
